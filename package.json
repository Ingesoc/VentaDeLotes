{
  "name": "verdant-horizon",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:prerender": "tsc -b && vite build && node scripts/prerender.mjs",
    "lint": "eslint .",
    "lint:doctor": "npx react-doctor@latest --verbose",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:mutation": "stryker run",
    "upload:lots": "node scripts/upload-lots.mjs",
    "preview": "vite preview --port 4173",
    "prepare": "husky",
    "lighthouse:mobile": "lighthouse http://localhost:4173 --config-path=lighthouse.config.mjs --output=html --output-path=./reports/lighthouse-mobile.html --chrome-flags=\"--headless=new --no-sandbox\"",
    "lighthouse:mobile:json": "lighthouse http://localhost:4173 --config-path=lighthouse.config.mjs --output=json --output-path=./reports/lighthouse-mobile.json --chrome-flags=\"--headless=new --no-sandbox\"",
    "lighthouse:desktop": "lighthouse http://localhost:4173 --preset=desktop --output=html --output-path=./reports/lighthouse-desktop.html --chrome-flags=\"--headless=new --no-sandbox\"",
    "lighthouse:multi": "npm run lighthouse:mobile && npm run lighthouse:desktop",
    "predaudit": "mkdir -p reports",
    "audit:kill": "taskkill /F /IM node.exe 2>nul || exit /b 0",
    "audit:preview": "start /B npx vite preview --port 4173 --host",
    "audit:mobile": "npm run build && npm run predaudit && start /B npm run preview && timeout /t 5 /nobreak >nul && npm run lighthouse:mobile && npm run audit:kill",
    "audit:all": "npm run build && npm run predaudit && npm run audit:preview && timeout /t 5 /nobreak >nul && npm run lighthouse:mobile && npm run lighthouse:mobile:json && npm run lighthouse:desktop && npm run audit:kill",
    "audit:script": "node run-lighthouse.mjs",
    "lighthouse:ci": "node scripts/lighthouse-ci.mjs",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:debug": "playwright test --debug",
    "test:e2e:mobile": "playwright test --project=chromium-mobile",
    "test:e2e:install": "playwright install chromium"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.4.0",
    "@supabase/supabase-js": "^2.110.0",
    "@tailwindcss/vite": "^4.3.2",
    "@tanstack/react-query": "^5.101.4",
    "@tanstack/react-table": "^9.1.2",
    "embla-carousel-autoplay": "^8.6.0",
    "embla-carousel-react": "^8.6.0",
    "lucide-react": "^1.22.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-helmet-async": "^3.0.0",
    "react-hook-form": "^7.80.0",
    "react-router": "^8.3.0",
    "recharts": "^3.10.1",
    "tailwindcss": "^4.3.2",
    "vite-plugin-sitemap": "^0.8.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.0",
    "@stryker-mutator/core": "^9.6.1",
    "@stryker-mutator/vitest-runner": "^9.6.1",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^10.6.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.7.0",
    "happy-dom": "^20.11.1",
    "husky": "^9.1.7",
    "jsdom": "^29.1.1",
    "lighthouse": "^13.4.1",
    "lint-staged": "^17.0.8",
    "prettier": "^3.9.4",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.62.0",
    "vite": "^8.1.1",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.10",
    "xlsx": "^0.18.5"
  },
  "knip": {
    "entry": [
      "stryker.config.mjs"
    ]
  },
  "overrides": {
    "postcss": "^8.5.18",
    "qs": "^6.15.2",
    "@trickfilm400/rollup-plugin-off-main-thread": "4.0.0-pre2",
    "brace-expansion": "5.0.9",
    "fast-uri": "3.1.5",
    "nanoid": "3.3.18"
  }
}
