# ─── Supabase (obligatorio) ────────────────────────────
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# ─── Cloudinary (obligatorio para subir imágenes desde el admin) ───
VITE_CLOUDINARY_CLOUD_NAME=your-cloud-name
VITE_CLOUDINARY_UPLOAD_PRESET=your-upload-preset

# ─── Datos vivos (opcional) ─────────────────────────────
# Activa la lectura de los lotes del sitio público desde Supabase en lugar de
# las constantes estáticas. Antes de activarlo, aplica la migración
# supabase/migration-live-lots.sql en el proyecto de Supabase.
VITE_LIVE_LOTS=false
